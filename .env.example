# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowdesk?schema=public"

# Secret used to sign JWT session tokens — change this in production
JWT_SECRET="dev-secret-change-me-to-a-long-random-string"

# Realtime (Socket.io) server
WS_PORT=4000
NEXT_PUBLIC_WS_URL="http://localhost:4000"
